import java.util.*;

class LinearSearch {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt(), a[] = new int[n];

        for(int i=0;i<n;i++) a[i] = sc.nextInt();
        int key = sc.nextInt();

        for(int i=0;i<n;i++) {
            if(a[i] == key) {
                System.out.println("Found at position " + (i+1));
                return;
            }
        }
        System.out.println("Not found");
    }
}
